# ====================================================================
# WALK WITH BUDDY - ENVIRONMENT CONFIGURATION
# ====================================================================
# Copy this file to .env and fill in your Supabase project credentials.
# Note: In Expo, environment variables prefixed with EXPO_PUBLIC_ are bundled into the app.

# 1. Supabase Project URL
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous (Public) Key
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon public"
# NEVER use the "service_role" secret key here! Row Level Security (RLS) protects the anon key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
